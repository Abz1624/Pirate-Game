<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hackathon devnet end-to-end smoke test against a running API (see Program.cs). Not part of the API image. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevnetSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Solnet.Programs" Version="6.1.0" />
    <PackageReference Include="Solnet.Rpc" Version="6.1.0" />
    <PackageReference Include="Solnet.Wallet" Version="6.1.0" />
  </ItemGroup>
</Project>
