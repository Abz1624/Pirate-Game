%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9301fa1770276174e848c12ef8b55328, type: 3}
  m_Name: SaltwindNarrative
  m_EditorClassIdentifier: RoguePirates.V4.Config::RoguePirates.V4.Config.NarrativeConfig
  configId: narrative.saltwind
  schemaVersion: 1
  balanceVersion: saltwind-v3-parity
  barksEnabled: 1
  tutorialEnabled: 1
  globalCooldownSeconds: 10
  barkSeconds: 3.5
  quietAfterBossSeconds: 6
  pennyName: Penny
  chipmunkName: Chippy
  bossName: Barnacle King
  barks:
  - barkId: start_penny
    enabled: 1
    speaker: 0
    trigger: 0
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - Try to bring the ship back this time.
    - The repair bill's already open. Just in case.
    - Get rich. Come home. In that order.
    captainLines: []
    cooldownSeconds: 9999
    priority: 5
    oncePerRun: 1
  - barkId: start_captain
    enabled: 1
    speaker: 3
    trigger: 0
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - This one's going to be a story.
    - Exactly as planned.
    captainLines:
    - captainKey: rook
      lines:
      - This one's going to be a story.
      - Exactly as planned.
    - captainKey: brine
      lines:
      - Ship's sound. Let's go.
      - Nobody's running today.
    - captainKey: richie
      lines:
      - Let's go make some money.
      - Every coin comes home with me.
    - captainKey: flint
      lines:
      - I have an idea.
      - Brought extra powder. Don't ask.
    - captainKey: ember
      lines:
      - Let's see what catches.
      - Nice and slow.
    - captainKey: roxie
      lines:
      - Let's find something fast.
      - Closer is better.
    cooldownSeconds: 9999
    priority: 4
    oncePerRun: 1
  - barkId: streak_captain
    enabled: 1
    speaker: 3
    trigger: 1
    value: 8
    windowSeconds: 6
    tag: 
    lines:
    - Exactly as planned.
    - They'll write songs about this.
    captainLines:
    - captainKey: rook
      lines:
      - Exactly as planned.
      - They'll write songs about this.
    - captainKey: brine
      lines:
      - Still floating.
      - Next.
    - captainKey: richie
      lines:
      - That's profit sinking. Theirs.
    - captainKey: flint
      lines:
      - That was a small one.
      - Bigger next time.
    - captainKey: ember
      lines:
      - Let it spread.
      - There. Much better.
    - captainKey: roxie
      lines:
      - Again.
      - Closer next time.
    cooldownSeconds: 45
    priority: 3
    oncePerRun: 0
  - barkId: streak_penny
    enabled: 1
    speaker: 0
    trigger: 1
    value: 15
    windowSeconds: 6
    tag: 
    lines:
    - That's a lot of wreckage. None of it ours, for once.
    captainLines: []
    cooldownSeconds: 90
    priority: 2
    oncePerRun: 0
  - barkId: level_penny
    enabled: 1
    speaker: 0
    trigger: 2
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - Another upgrade. I'll pretend it was budgeted.
    - Fine. Bolt it on.
    captainLines: []
    cooldownSeconds: 60
    priority: 1
    oncePerRun: 0
  - barkId: level_captain
    enabled: 1
    speaker: 3
    trigger: 2
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - Even better than planned.
    captainLines:
    - captainKey: rook
      lines:
      - Even better than planned.
    - captainKey: brine
      lines:
      - Sturdier. Good.
    - captainKey: richie
      lines:
      - An investment. Technically.
    - captainKey: flint
      lines:
      - Ooh. That's going to be loud.
    - captainKey: ember
      lines:
      - Needs another minute.
    - captainKey: roxie
      lines:
      - Faster. Good.
    cooldownSeconds: 75
    priority: 1
    oncePerRun: 0
  - barkId: chest_chippy
    enabled: 1
    speaker: 1
    trigger: 3
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - '*Chippy''s cheeks are suddenly very full*'
    - '*Chippy inspects the chest, then the Captain''s pockets*'
    captainLines: []
    cooldownSeconds: 60
    priority: 3
    oncePerRun: 0
  - barkId: chest_penny
    enabled: 1
    speaker: 0
    trigger: 3
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - Salvage. Legally, probably ours.
    captainLines: []
    cooldownSeconds: 90
    priority: 2
    oncePerRun: 0
  - barkId: landmark_penny
    enabled: 1
    speaker: 0
    trigger: 4
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - Useful. Don't get used to useful.
    captainLines: []
    cooldownSeconds: 60
    priority: 2
    oncePerRun: 0
  - barkId: landmark_chippy
    enabled: 1
    speaker: 1
    trigger: 4
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - '*Chippy pockets a compass part. Nobody saw.*'
    captainLines: []
    cooldownSeconds: 90
    priority: 1
    oncePerRun: 0
  - barkId: beacon_hint_penny
    enabled: 1
    speaker: 0
    trigger: 5
    value: 1
    windowSeconds: 6
    tag: 
    lines:
    - The Beacon's out there. So is whoever thinks he owns it.
    captainLines: []
    cooldownSeconds: 9999
    priority: 4
    oncePerRun: 1
  - barkId: beacon_spotted_penny
    enabled: 1
    speaker: 0
    trigger: 6
    value: 3
    windowSeconds: 6
    tag: 
    lines:
    - There's the Treasury Beacon. The sea keeps receipts, Captain.
    captainLines: []
    cooldownSeconds: 9999
    priority: 6
    oncePerRun: 1
  - barkId: boss_summoned_king
    enabled: 1
    speaker: 2
    trigger: 7
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - Your ship is improperly docked.
    - That treasure is unpaid tax.
    - Everything in Saltwind is MY property.
    captainLines: []
    cooldownSeconds: 9999
    priority: 8
    oncePerRun: 1
  - barkId: boss_summoned_penny
    enabled: 1
    speaker: 0
    trigger: 7
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - That's the Barnacle King. He'll want paperwork.
    captainLines: []
    cooldownSeconds: 9999
    priority: 7
    oncePerRun: 1
  - barkId: boss_summoned_captain
    enabled: 1
    speaker: 3
    trigger: 7
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - We meet again. Probably.
    captainLines:
    - captainKey: rook
      lines:
      - We meet again. Probably.
    - captainKey: brine
      lines:
      - Not moving.
    - captainKey: richie
      lines:
      - He wants tax? From me?
    - captainKey: flint
      lines:
      - I have an idea.
    - captainKey: ember
      lines:
      - He'll catch.
    - captainKey: roxie
      lines:
      - Now it's interesting.
    cooldownSeconds: 9999
    priority: 6
    oncePerRun: 1
  - barkId: boss_defeated_penny
    enabled: 1
    speaker: 0
    trigger: 8
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - We're done. Come home.
    - Objective secured. The sensible thing now is to stop.
    captainLines: []
    cooldownSeconds: 9999
    priority: 9
    oncePerRun: 1
  - barkId: boss_defeated_chippy
    enabled: 1
    speaker: 1
    trigger: 8
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - '*Chippy claims the Barnacle King''s crown. It is shiny.*'
    captainLines: []
    cooldownSeconds: 9999
    priority: 8
    oncePerRun: 1
  - barkId: boss_defeated_captain
    enabled: 1
    speaker: 3
    trigger: 8
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - Exactly as planned. Now, about that chest...
    captainLines:
    - captainKey: rook
      lines:
      - Exactly as planned. Now, about that chest...
    - captainKey: brine
      lines:
      - Told you. No dodging needed.
    - captainKey: richie
      lines:
      - Now we collect.
    - captainKey: flint
      lines:
      - Can I keep the crown? For science.
    - captainKey: ember
      lines:
      - There. Much better.
    - captainKey: roxie
      lines:
      - Again.
    cooldownSeconds: 9999
    priority: 7
    oncePerRun: 1
  - barkId: elite_hammer_penny
    enabled: 1
    speaker: 0
    trigger: 9
    value: 0
    windowSeconds: 6
    tag: elite_hammerhead
    lines:
    - That hammerhead looks personally offended.
    captainLines: []
    cooldownSeconds: 9999
    priority: 5
    oncePerRun: 1
  - barkId: elite_kraken_penny
    enabled: 1
    speaker: 0
    trigger: 9
    value: 0
    windowSeconds: 6
    tag: elite_kraken
    lines:
    - Kraken spawn. I'm not paying for tentacle damage.
    captainLines: []
    cooldownSeconds: 9999
    priority: 5
    oncePerRun: 1
  - barkId: reef_crab_penny
    enabled: 1
    speaker: 0
    trigger: 9
    value: 0
    windowSeconds: 6
    tag: reef_crab
    lines:
    - A reef crab. Armoured. Unreasonably so.
    captainLines: []
    cooldownSeconds: 9999
    priority: 5
    oncePerRun: 1
  - barkId: overtime_penny
    enabled: 1
    speaker: 0
    trigger: 9
    value: 0
    windowSeconds: 6
    tag: overtime
    lines:
    - We already won. We could leave. We won't. Noted.
    captainLines: []
    cooldownSeconds: 9999
    priority: 6
    oncePerRun: 1
  - barkId: storm_penny
    enabled: 1
    speaker: 0
    trigger: 10
    value: 0
    windowSeconds: 6
    tag: storm
    lines:
    - Storm's coming. I've seen your sailing. This will be expensive.
    captainLines: []
    cooldownSeconds: 9999
    priority: 6
    oncePerRun: 1
  - barkId: hull_low_penny
    enabled: 1
    speaker: 0
    trigger: 11
    value: 0.3
    windowSeconds: 6
    tag: 
    lines:
    - The hull is mostly holes now.
    - Repairs are getting expensive.
    captainLines: []
    cooldownSeconds: 45
    priority: 7
    oncePerRun: 0
  - barkId: hull_low_captain
    enabled: 1
    speaker: 3
    trigger: 11
    value: 0.15
    windowSeconds: 6
    tag: 
    lines:
    - All part of the plan.
    captainLines:
    - captainKey: rook
      lines:
      - All part of the plan.
    - captainKey: brine
      lines:
      - No.
    - captainKey: richie
      lines:
      - The ship looks fine.
    - captainKey: flint
      lines:
      - Structural integrity is overrated.
    - captainKey: ember
      lines:
      - Just a little singed.
    - captainKey: roxie
      lines:
      - Closer.
    cooldownSeconds: 60
    priority: 6
    oncePerRun: 0
  - barkId: gold_penny
    enabled: 1
    speaker: 0
    trigger: 12
    value: 150
    windowSeconds: 6
    tag: 
    lines:
    - 'Good news: Gold. Bad news: repairs.'
    captainLines: []
    cooldownSeconds: 9999
    priority: 3
    oncePerRun: 1
  - barkId: gold_chippy
    enabled: 1
    speaker: 1
    trigger: 12
    value: 300
    windowSeconds: 6
    tag: 
    lines:
    - '*Chippy eyes the Gold with professional interest*'
    captainLines: []
    cooldownSeconds: 9999
    priority: 2
    oncePerRun: 1
  - barkId: quiet_penny
    enabled: 1
    speaker: 0
    trigger: 13
    value: 25
    windowSeconds: 6
    tag: 
    lines:
    - Quiet. I don't like quiet.
    captainLines: []
    cooldownSeconds: 120
    priority: 1
    oncePerRun: 0
  - barkId: quiet_chippy
    enabled: 1
    speaker: 1
    trigger: 13
    value: 40
    windowSeconds: 6
    tag: 
    lines:
    - '*Chippy naps in a coil of rope*'
    captainLines: []
    cooldownSeconds: 150
    priority: 1
    oncePerRun: 0
  - barkId: streak_chippy
    enabled: 1
    speaker: 1
    trigger: 1
    value: 20
    windowSeconds: 6
    tag: 
    lines:
    - '*Chippy applauds, then pockets a coin from the applause*'
    captainLines: []
    cooldownSeconds: 120
    priority: 1
    oncePerRun: 0
  - barkId: level_chippy
    enabled: 1
    speaker: 1
    trigger: 2
    value: 0
    windowSeconds: 6
    tag: 
    lines:
    - '*Chippy tests the new part with its teeth*'
    captainLines: []
    cooldownSeconds: 150
    priority: 0
    oncePerRun: 0
  tutorial:
  - stepId: move
    prompt: Sail with WASD or the left stick.
    completesOn: 0
    promptSeconds: 6
    skipAfterSeconds: 0
    showOnComplete: 0
    silent: 0
  - stepId: autofire_xp
    prompt: Your guns fire on their own. Sink ships and sail over the XP they drop.
    completesOn: 1
    promptSeconds: 6
    skipAfterSeconds: 0
    showOnComplete: 0
    silent: 0
  - stepId: level_up
    prompt: "Level up: pick one card: a new weapon, an upgrade or a Logbook."
    completesOn: 2
    promptSeconds: 6
    skipAfterSeconds: 0
    showOnComplete: 0
    silent: 0
  - stepId: chest
    prompt: Salvage chests hold items. Sail up to one and hold E to open it.
    completesOn: 3
    promptSeconds: 6
    skipAfterSeconds: 150
    showOnComplete: 0
    silent: 0
  - stepId: landmark
    prompt: 'The minimap marks landmarks. Use one: a Repair Wreck, a Signal Buoy
      or a Treasure Chart.'
    completesOn: 4
    promptSeconds: 6
    skipAfterSeconds: 150
    showOnComplete: 0
    silent: 0
  - stepId: beacon
    prompt: Find the Treasury Beacon (the minimap points to it) and hold E to call
      its guardian.
    completesOn: 5
    promptSeconds: 6
    skipAfterSeconds: 0
    showOnComplete: 0
    silent: 0
  - stepId: boss_telegraph
    prompt: Marked water shows where the Barnacle King will strike. Sail out of it.
    completesOn: 6
    promptSeconds: 6
    skipAfterSeconds: 0
    showOnComplete: 0
    silent: 0
  - stepId: claim
    prompt: "TERRITORY CLAIMED: SURVIVE AS LONG AS YOU CAN."
    completesOn: 7
    promptSeconds: 6
    skipAfterSeconds: 0
    showOnComplete: 1
    silent: 1
  - stepId: death_summary
    prompt: 'Leftover gold is banked as Rum. Rum is yours to keep: spend it on unlocks
      between voyages.'
    completesOn: 8
    promptSeconds: 8
    skipAfterSeconds: 0
    showOnComplete: 1
    silent: 0
