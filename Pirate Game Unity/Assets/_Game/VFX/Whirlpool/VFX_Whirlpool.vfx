  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966676386}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966676408}
  - {fileID: 114350483966676409}
  - {fileID: 114350483966676410}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966676407}
  m_BlockName: Mist Init
  m_HLSLCode: "void MistInitFn(inout VFXAttributes attributes, in float Radius, in
    float OverallScale, in float RotationSpeed)\n{\n  float R = max(Radius * OverallScale,
    0.01);\n  float a = VFXRAND * 6.2831853;\n  float rn = lerp(0.88, 1.05, VFXRAND);\n 
    float2 dir = float2(cos(a), sin(a));\n  float2 tang = float2(dir.y, -dir.x);\n 
    attributes.position = float3(dir.x * R * rn, R * 0.02, dir.y * R * rn);\n  float
    vt = RotationSpeed * R * 0.25;\n  attributes.velocity = float3(tang.x * vt -
    dir.x * R * 0.01, R * lerp(0.02, 0.05, VFXRAND), tang.y * vt - dir.y * R * 0.01);\n 
    attributes.lifetime = lerp(4.0, 6.5, VFXRAND);\n  attributes.texIndex = VFXRAND;\n 
    attributes.angleZ = VFXRAND * 360.0;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: MistInitFn
    selectedIndex: 0
