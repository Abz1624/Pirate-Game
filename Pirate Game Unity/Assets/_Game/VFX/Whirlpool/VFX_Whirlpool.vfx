  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966676448}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966676457}
  - {fileID: 114350483966676458}
  - {fileID: 114350483966676459}
  - {fileID: 114350483966676460}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966676456}
  m_BlockName: Centre Glow Motion
  m_HLSLCode: "void GlowFn(inout VFXAttributes attributes, in float Radius, in float
    FunnelDepth, in float OverallScale, in float GlowIntensity)\n{\n  float R = max(Radius
    * OverallScale, 0.01);\n  float D = FunnelDepth * OverallScale;\n  uint id =
    attributes.particleId % 3;\n  attributes.alpha = 1.0;\n  if (id == 0) { attributes.position
    = float3(0, -D * 0.92, 0); attributes.size = R * 0.34;  attributes.color = float3(0.8,
    0.97, 1.0) * GlowIntensity * 1.1; }\n  else if (id == 1) { attributes.position
    = float3(0, -D * 0.7, 0); attributes.size = R * 1.1; attributes.color = float3(0.12,
    0.6, 1.0) * GlowIntensity * 0.3; }\n  else { attributes.position = float3(0,
    -D * 0.25, 0); attributes.size = R * 2.6; attributes.color = float3(0.03, 0.3,
    1.0) * GlowIntensity * 0.1; }\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: GlowFn
    selectedIndex: 0
