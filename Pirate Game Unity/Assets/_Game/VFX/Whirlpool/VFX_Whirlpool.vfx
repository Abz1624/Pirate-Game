  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966676182}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966676204}
  - {fileID: 114350483966676205}
  - {fileID: 114350483966676206}
  - {fileID: 114350483966676207}
  - {fileID: 114350483966676208}
  - {fileID: 114350483966676209}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966676203}
  m_BlockName: Foam Init
  m_HLSLCode: "void FoamInit(inout VFXAttributes attributes, in float Radius, in
    float FunnelDepth, in float OverallScale, in float MinR, in float MaxR, in float
    Life)\n{\n  float R = max(Radius * OverallScale, 0.01);\n  float D = FunnelDepth
    * OverallScale;\n  float a = VFXRAND * 6.2831853;\n  float rn = lerp(MinR, MaxR,
    sqrt(VFXRAND));\n  float r = R * rn;\n  attributes.position = float3(cos(a) *
    r, -D * pow(saturate(1.0 - rn), 2.2), sin(a) * r);\n  attributes.lifetime = Life
    * lerp(0.7, 1.3, VFXRAND);\n  attributes.texIndex = VFXRAND;\n  attributes.alpha
    = 0;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: FoamInit
    selectedIndex: 0
