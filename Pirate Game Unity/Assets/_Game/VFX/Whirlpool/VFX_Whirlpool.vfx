  - {fileID: 114350483966676370}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966676366}
  m_BlockName: Spray Motion
  m_HLSLCode: "void SprayFn(inout VFXAttributes attributes, in float Radius, in float
    OverallScale, in float WaterOpacity, in float GlowIntensity)\n{\n  float R =
    max(Radius * OverallScale, 0.01);\n  float g = R * 0.9;\n  attributes.velocity
    = attributes.targetPosition - float3(0, g * attributes.age, 0);\n  float k =
    attributes.age / attributes.lifetime;\n  attributes.alpha = saturate(sin(3.14159
    * k)) * 0.85 * WaterOpacity;\n  attributes.color = lerp(float3(0.6, 0.95, 1.0),
    float3(1, 1, 1), attributes.texIndex) * (1.0 + GlowIntensity * 0.15);\n  attributes.scaleX
    = R * lerp(0.004, 0.009, attributes.texIndex);\n  attributes.scaleY = max(attributes.scaleX,
    length(attributes.velocity) * 0.05);\n  attributes.size = 1.0;\n}"
