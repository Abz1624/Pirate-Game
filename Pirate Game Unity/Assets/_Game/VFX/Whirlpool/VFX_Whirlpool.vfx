  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966676411}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966676420}
  - {fileID: 114350483966676421}
  - {fileID: 114350483966676422}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966676419}
  m_BlockName: Mist Motion
  m_HLSLCode: "void MistFn(inout VFXAttributes attributes, in float Radius, in float
    OverallScale, in float WaterOpacity)\n{\n  float R = max(Radius * OverallScale,
    0.01);\n  float k = attributes.age / attributes.lifetime;\n  attributes.alpha
    = sin(3.14159 * k) * 0.045 * WaterOpacity;\n  attributes.color = float3(0.55,
    0.85, 1.0);\n  attributes.size = R * lerp(0.1, 0.22, k) * (0.7 + attributes.texIndex
    * 0.6);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: MistFn
    selectedIndex: 0
