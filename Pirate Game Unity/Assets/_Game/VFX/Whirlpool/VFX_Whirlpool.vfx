  - {fileID: 114350483966675895}
  - {fileID: 114350483966675896}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675885}
  m_BlockName: Foam Layer Motion
  m_HLSLCode: "void FoamLayer(inout VFXAttributes attributes, in float Radius, in
    float FunnelDepth, in float RotationSpeed, in float OverallScale, in float WaterOpacity,
    in float GlowIntensity, in float RadiusMul, in float SpinMul, in float Lift,
    in float AlphaMul, in float GlowMul)\n{\n  float R = max(Radius * OverallScale,
    0.01);\n  float D = max(FunnelDepth * OverallScale, 0.001);\n  float m = saturate(RadiusMul);\n 
    float top = pow(1.0 - m, 2.2);\n  attributes.position = float3(0, -D * top +
    Lift * R, 0);\n  attributes.scaleX = 2.0 * R * RadiusMul;\n  attributes.scaleZ
    = 2.0 * R * RadiusMul;\n  attributes.scaleY = max(D * (1.0 - top), 0.001);\n 
    attributes.size = 1.0;\n  attributes.angularVelocityY = RotationSpeed * SpinMul
    * 57.29578;\n  attributes.alpha = saturate(AlphaMul * WaterOpacity);\n  attributes.color
    = float3(1, 1, 1) * (1.0 + GlowIntensity * GlowMul);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: FoamLayer
    selectedIndex: 0
