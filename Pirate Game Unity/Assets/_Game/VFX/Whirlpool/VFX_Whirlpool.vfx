  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966676332}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966676354}
  - {fileID: 114350483966676355}
  - {fileID: 114350483966676356}
  - {fileID: 114350483966676357}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966676353}
  m_BlockName: Spray Init
  m_HLSLCode: "void SprayInitFn(inout VFXAttributes attributes, in float Radius,
    in float FunnelDepth, in float OverallScale, in float RotationSpeed)\n{\n  float
    R = max(Radius * OverallScale, 0.01);\n  float D = FunnelDepth * OverallScale;\n 
    float a = VFXRAND * 6.2831853;\n  float rn = lerp(0.15, 0.95, VFXRAND);\n  float2
    dir = float2(cos(a), sin(a));\n  float2 tang = float2(dir.y, -dir.x);\n  attributes.position
    = float3(dir.x * R * rn, -D * pow(1.0 - rn, 2.2), dir.y * R * rn);\n  float vt
    = RotationSpeed * R * 0.3 / sqrt(rn + 0.03);\n  float up = lerp(0.07, 0.2, VFXRAND)
    * R * (0.4 + (1.0 - rn));\n  attributes.targetPosition = float3(tang.x * vt +
    dir.x * R * 0.05, up, tang.y * vt + dir.y * R * 0.05);\n  attributes.lifetime
    = lerp(0.6, 1.2, VFXRAND);\n  attributes.texIndex = VFXRAND;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SprayInitFn
    selectedIndex: 0
