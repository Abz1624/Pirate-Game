  m_ActivationSlot: {fileID: 114350483966675995}
  m_BlockName: Outer Current Motion
  m_HLSLCode: "void OuterCurrent(inout VFXAttributes attributes, in float Radius,
    in float RotationSpeed, in float InwardForce, in float FunnelDepth, in float
    Turbulence, in float OverallScale, in float WaterOpacity, in float GlowIntensity,
    in float SpeedMul, in float Width, in float Stretch, in float Alpha, in float
    Lift, in float3 TintA, in float3 TintB)\n{\n  float R = max(Radius * OverallScale,
    0.01);\n  float D = FunnelDepth * OverallScale;\n  float3 p = attributes.position;\n 
    float r = max(length(p.xz), 0.0001);\n  float rn = saturate(r / R);\n  float2
    dir = p.xz / r;\n  float2 tang = float2(dir.y, -dir.x);\n  float inner = 1.0
    - rn;\n  float t = attributes.age + attributes.texIndex * 17.0;\n  float n1 =
    sin(p.x / R * 9.0 + t * 2.3) * cos(p.z / R * 8.0 - t * 1.7);\n  float n2 = sin((p.x
    + p.z) / R * 13.0 - t * 3.1);\n  float turb = Turbulence * (0.25 + inner * 1.2);\n 
    float vt = RotationSpeed * R * SpeedMul * (0.55 / sqrt(rn + 0.03)) * (1.0 + n2
    * turb * 0.2);\n  float vr = InwardForce * R * SpeedMul * (0.18 + 0.9 * inner
    * inner) + n1 * turb * R * 0.25;\n  float2 vxz = tang * vt - dir * vr;\n  float
    yT = -D * pow(inner, 2.2) + Lift * R * (0.3 + attributes.texIndex) + n2 * turb
    * R * 0.01;\n  attributes.velocity = float3(vxz.x, (yT - p.y) * 10.0, vxz.y);\n 
    float fadeIn = saturate(attributes.age / 0.6);\n  float fadeOut = saturate((attributes.lifetime
    - attributes.age) / 0.8);\n  float edge = smoothstep(1.08, 0.85, rn);\n  float
    core = smoothstep(0.02, 0.12, rn);\n  attributes.alpha = Alpha * WaterOpacity
    * fadeIn * fadeOut * edge * core;\n  float hot = pow(inner, 3.0);\n  attributes.color
    = lerp(TintA, TintB, hot) * (1.0 + GlowIntensity * 0.35 * hot);\n  attributes.scaleX
    = Width * R * (0.35 + 0.65 * rn);\n  attributes.scaleY = max(attributes.scaleX,
    length(vxz) * Stretch);\n  attributes.size = 1.0;\n  if (rn < 0.03) attributes.alive
    = false;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: OuterCurrent
    selectedIndex: 0
